# Used only by scripts/init-github.sh (runs once on your machine).
# Copy to .env and fill it in. .env is git-ignored.

# Public IP (or hostname) of the VPS
VPS_HOST=203.0.113.10

# Base domain. Point a wildcard DNS record at the VPS: *.example.com -> VPS_HOST
DOKKU_DOMAIN=example.com

# Let's Encrypt expiry notices go here
LETSENCRYPT_EMAIL=you@example.com

# GitHub user/org that owns the images in ghcr.io (default: the user logged into gh)
# GHCR_USER=

# Optional: Dokku version and swap size used by the bootstrap
# DOKKU_TAG=v0.38.34
# SWAP_SIZE=2G
